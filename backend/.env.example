NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://rental_admin:rental_password@localhost:5432/vehicle_rental?schema=public"

# Base64-encoded Firebase service-account JSON (Project Settings > Service accounts
# > Generate new private key, then `base64 -i key.json` on macOS/Linux). Never commit
# the decoded value or the raw key file.
# Option A — local dev with NO secret. Uncomment, then run:
#   firebase emulators:start --only auth
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_PROJECT_ID=vehicle-rent-001

# Option B — service-account JSON on disk (preferred on Cloud Run / k8s).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Option C — base64 of that JSON, for env-only hosts.
FIREBASE_SERVICE_ACCOUNT_B64=

CORS_ORIGIN=http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vehicle Rental Marketplace <no-reply@example.com>"

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

GOOGLE_MAPS_API_KEY=
